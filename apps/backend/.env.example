MEDUSA_ADMIN_ONBOARDING_TYPE=default

# --- CORS: which origins may call this backend ---
STORE_CORS=http://localhost:3000,https://urban-men.vercel.app
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:3000,https://urban-men.vercel.app,http://localhost:9000,http://localhost:5173

# --- Database (Neon free Postgres) ---
# Get this from your Neon project dashboard -> Connection string
# Looks like: postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Redis (Upstash free Redis) ---
# Get this from your Upstash database -> Details -> "Redis Connect" (the redis:// or rediss:// URL)
# Used by Medusa's event bus/workflows AND our reservation-hold TTL logic
REDIS_URL=redis://localhost:6379

# Generate real random values for these before deploying anywhere shared
# (e.g. `openssl rand -hex 32`) — the values below are dev-only placeholders
JWT_SECRET=replace-with-a-random-secret
COOKIE_SECRET=replace-with-a-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-random-hex-string

# --- Payments (Paystack, test mode) ---
# From your Paystack dashboard -> Settings -> API Keys & Webhooks (use the TEST keys for now)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Where product photos are served from while seeding (the website)
STOREFRONT_URL=https://urban-men.vercel.app

# --- Media (Cloudinary free tier) ---
# From your Cloudinary dashboard home page
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Who is who (see src/lib/rbac.ts) ---
# The root owner: the only account that can change its own email/credentials and the only one nobody else can remove.
ROOT_ADMIN_EMAIL=kkwesi956@gmail.com
# Full-access administrators (comma separated). They get the invite link from `npm run invite-admins`.
ADMIN_EMAILS=mandyemefa@gmail.com,nagbrand@gmail.com
# Public address of this backend (used for invite links and admin links in emails)
BACKEND_URL=http://localhost:9000

# --- Notifications ---
# Emails go through Resend (free: 3,000/month). Without a key, emails are only written to the server log.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, e.g. Urban Men <orders@yourdomain.com>
NOTIFICATION_FROM=Urban Men <onboarding@resend.dev>
# Team alerts (orders, style requests, reviews, low stock) go only to staff who opted in:
# Medusa admin > My notifications. There is no list of recipients to set here.
# Optional: Expo access token for push notifications (not needed to start)
EXPO_ACCESS_TOKEN=
# A size with this many units or fewer is "low" in the morning stock email
LOW_STOCK_THRESHOLD=3

# --- Sign in with Google (customers) ---
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client (Web). Add GOOGLE_CALLBACK_URL as an authorised redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
